[Unit]
Description=Raspberry Pi YouTube-to-Sonos Web Player
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__APP_DIR__/backend
EnvironmentFile=-__APP_DIR__/.env
ExecStart=__APP_DIR__/venv/bin/python app.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# yt-dlp cache must be writable despite ProtectHome=read-only
Environment=XDG_CACHE_HOME=__APP_DIR__/.cache

# Security hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=__APP_DIR__

[Install]
WantedBy=multi-user.target
